{
	"name" : "muckiware/log-plugin",
	"description" : "Mucki Log Plugin",
	"version": "v2.2.0",
	"type" : "shopware-platform-plugin",
	"license" : "MIT",
	"authors": [
		{
			"name": "muckiware"
		}
	],
	"extra" : {
		"shopware-plugin-class" : "MuckiLogPlugin\\MuckiLogPlugin",
		"copyright" : "(c) by muckiware",
		"label" : {
			"de-DE" : "Mucki Log Erweiterung",
			"en-GB" : "Mucki Log Plugin"
		}
	},
	"require" : {
		"php" : ">= 8.1"
	},
	"require-dev" : {
		"phpstan/phpstan" : "*"
	},
	"autoload" : {
		"psr-4" : {
			"MuckiLogPlugin\\" : "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MuckiLogPlugin\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"symfony/runtime": true,
			"php-http/discovery": false
		}
	},
	"scripts": {
		"phpstan": "./vendor/bin/phpstan analyse -n --no-progress"
	}
}