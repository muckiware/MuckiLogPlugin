<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <imports>
        <import resource="./schedule.xml"/>
    </imports>
    <services>
        <service id="MuckiLogPlugin\Core\LoggingEvent\LoggingEventDefinition">
            <tag name="shopware.entity.definition" entity="muwa_logging_event" />
        </service>
        <service id="MuckiLogPlugin\Core\AdminChangeLog\AdminChangeLogDefinition">
            <tag name="shopware.entity.definition" entity="muwa_admin_change_log" />
        </service>
    	<service id="MuckiLogPlugin\Services\Settings" public="true">
        	<argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        	<argument type="service" id="Symfony\Component\HttpKernel\KernelInterface"/>
        </service>
        <service id="MuckiLogPlugin\Services\SettingsInterface" alias="MuckiLogPlugin\Services\Settings"/>
        <service id="MuckiLogPlugin\Services\Logconfig" public="true">
        	<argument type="service" id="Symfony\Component\HttpKernel\KernelInterface"/>
        	<argument type="service" id="MuckiLogPlugin\Services\Settings"/>
        </service>
        <service id="MuckiLogPlugin\Services\LogconfigInterface" alias="MuckiLogPlugin\Services\Logconfig"/>
        <service id="MuckiLogPlugin\Logging\Logger" lazy="true">
            <argument type="service" id="event_dispatcher"/>
        	<argument type="service" id="MuckiLogPlugin\Services\Logconfig"/>
        	<argument type="service" id="MuckiLogPlugin\Services\Settings"/>
            <argument type="service" id="MuckiLogPlugin\Services\LoggingEvent"/>
        </service>
        <service id="MuckiLogPlugin\Logging\LoggerInterface" alias="MuckiLogPlugin\Logging\Logger"/>

        <service id="MuckiLogPlugin\Subscriber\ExceptionSubscriber">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="MuckiLogPlugin\Subscriber\ResponseHeaderListener">
        	<argument type="service" id="MuckiLogPlugin\Services\Logconfig"/>
        	<argument type="service" id="MuckiLogPlugin\Services\Settings"/>
        	<argument type="service" id="MuckiLogPlugin\Logging\LoggerInterface"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service class="MuckiLogPlugin\Commands\Checkup" id="muckilog.commands.checkup" public="true">
            <argument type="service" id="MuckiLogPlugin\Services\Settings"/>
            <argument type="service" id="MuckiLogPlugin\Services\LogconfigInterface"/>
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiLogPlugin\Logging\LoggerInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\LoggerServiceDecorator"/>
            <tag name="console.command"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
        <service class="MuckiLogPlugin\Commands\CheckupSwLogger" id="muckilog.commands.checkupSwLogger" public="true">
            <argument type="service" id="MuckiLogPlugin\Services\Settings"/>
            <argument type="service" id="logger"/>
            <tag name="console.command"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
        <service class="MuckiLogPlugin\Commands\SendNotification" id="muckilog.commands.sendNotification" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\Settings"/>
            <argument type="service" id="MuckiLogPlugin\Services\LogconfigInterface"/>
            <argument type="service" id="MuckiLogPlugin\Logging\LoggerInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\SendNotification"/>
            <tag name="console.command"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
        <service id="MuckiLogPlugin\Services\LoggerServiceDecorator" decorates="Psr\Log\LoggerInterface" decoration-priority="10">
            <argument type="service" id="MuckiLogPlugin\Services\LoggerServiceDecorator.inner" />
            <argument type="service" id="MuckiLogPlugin\Logging\LoggerInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\SettingsInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\Helper"/>
        </service>
        <service id="MuckiLogPlugin\Services\LoggingEvent" public="true">
            <argument type="service" id="muwa_logging_event.repository"/>
            <argument type="service" id="MuckiLogPlugin\Services\Settings"/>
        </service>
        <service id="MuckiLogPlugin\Services\Helper"/>
        <service id="MuckiLogPlugin\Services\LogViewer">
        	<argument type="service" id="MuckiLogPlugin\Services\SettingsInterface"/>
        </service>
        <service id="MuckiLogPlugin\Services\LogViewerInterface" alias="MuckiLogPlugin\Services\LogViewer"/>

        <service id="MuckiLogPlugin\Administration\Controller\LogViewerController" public="true">
        	<argument type="service" id="MuckiLogPlugin\Services\LogViewerInterface"/>
        	<tag name="controller.service_arguments"/>
        </service>
        <service id="MuckiLogPlugin\Services\SendNotification">
            <argument type="service" id="MuckiLogPlugin\Services\LoggingEvent"/>
            <argument type="service" id="MuckiLogPlugin\Services\CliOutput"/>
            <argument type="service" id="MuckiLogPlugin\Services\Mailer"/>
            <argument type="service" id="MuckiLogPlugin\Services\Settings"/>
        </service>
        <service id="MuckiLogPlugin\Services\CliOutput">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Psr\Log\LoggerInterface"/>
        </service>
        <service id="MuckiLogPlugin\Services\Mailer" public="true">
            <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
            <argument type="service" id="mail_template_type.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="MuckiLogPlugin\Services\Settings"/>
            <argument type="service" id="Psr\Log\LoggerInterface" />
        </service>

        <service id="MuckiLogPlugin\Services\HttpRequestLogFormatter" public="true"/>
        <service id="MuckiLogPlugin\Services\HttpRequestLogFormatterInterface" alias="MuckiLogPlugin\Services\HttpRequestLogFormatter"/>

        <service id="MuckiLogPlugin\Services\HttpClientLoggerDecorator" decorates="Symfony\Contracts\HttpClient\HttpClientInterface" decoration-priority="500">
            <argument type="service" id="MuckiLogPlugin\Services\HttpClientLoggerDecorator.inner" />
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\HttpRequestLogFormatterInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\SettingsInterface"/>
        </service>

        <service id="MuckiLogPlugin\Services\StoreClientLoggingMiddleware" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\HttpRequestLogFormatterInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\SettingsInterface"/>
        </service>

        <!-- Tags fuer beide Middlewares setzt der StoreClientMiddlewareCompilerPass je nach Shopware-Version -->
        <service id="MuckiLogPlugin\Services\LegacyStoreClientLoggingMiddleware" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\HttpRequestLogFormatterInterface"/>
            <argument type="service" id="MuckiLogPlugin\Services\SettingsInterface"/>
        </service>

        <service id="MuckiLogPlugin\Storefront\Controller\ErrorControllerDecorator" decorates="Shopware\Storefront\Controller\ErrorController" decoration-priority="100">
            <argument type="service" id="MuckiLogPlugin\Storefront\Controller\ErrorControllerDecorator.inner" />
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="Shopware\Storefront\Framework\Twig\ErrorTemplateResolver"/>
            <argument type="service" id="Shopware\Storefront\Pagelet\Header\HeaderPageletLoader"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Shopware\Storefront\Page\Navigation\Error\ErrorPageLoader"/>
            <argument type="service" id="Shopware\Storefront\Pagelet\Footer\FooterPageletLoader"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="MuckiLogPlugin\ChangeLog\ChangeLogConfig">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="MuckiLogPlugin\ChangeLog\ValueNormalizer"/>

        <service id="MuckiLogPlugin\ChangeLog\SensitiveFieldMasker"/>

        <service id="MuckiLogPlugin\ChangeLog\FieldChangeExtractor">
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\ValueNormalizer"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\SensitiveFieldMasker"/>
        </service>

        <service id="MuckiLogPlugin\ChangeLog\EntityGraph">
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
        </service>

        <service id="MuckiLogPlugin\ChangeLog\RootResolver">
            <argument type="service" id="MuckiLogPlugin\ChangeLog\EntityGraph"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="MuckiLogPlugin\ChangeLog\SourceResolver">
            <argument type="service" id="user.repository"/>
            <argument type="service" id="integration.repository"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="request_stack"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="MuckiLogPlugin\ChangeLog\EntityLabelResolver">
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Psr\Log\LoggerInterface"/>
        </service>

        <service id="MuckiLogPlugin\ChangeLog\ChangeLogWriter">
            <argument type="service" id="muwa_admin_change_log.repository"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\EntityLabelResolver"/>
            <argument type="service" id="Psr\Log\LoggerInterface"/>
        </service>

        <service id="MuckiLogPlugin\Subscriber\ChangeLogWriteSubscriber">
            <argument type="service" id="MuckiLogPlugin\ChangeLog\ChangeLogConfig"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\EntityGraph"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\RootResolver"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\FieldChangeExtractor"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\SourceResolver"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\ChangeLogWriter"/>
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="MuckiLogPlugin\Subscriber\SystemConfigChangeSubscriber">
            <argument type="service" id="MuckiLogPlugin\ChangeLog\ChangeLogConfig"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\SensitiveFieldMasker"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\ValueNormalizer"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\SourceResolver"/>
            <argument type="service" id="MuckiLogPlugin\ChangeLog\ChangeLogWriter"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>