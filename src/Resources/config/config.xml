<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/platform/master/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title>MuckiLogPlugin global settings</title>
        <input-field type="bool">
            <name>active</name>
            <label>Active</label>
        </input-field>
        <input-field type="single-select">
            <name>level</name>
            <options>
                <option>
                    <id>critical</id>
                    <name>Critical</name>
                </option>
                <option>
                    <id>error</id>
                    <name>Error</name>
                </option>
                <option>
                    <id>warning</id>
                    <name>Warning</name>
                </option>
                <option>
                    <id>info</id>
                    <name>Info</name>
                </option>
                <option>
                    <id>debug</id>
                    <name>Debug</name>
                </option>
            </options>
            <label>Log Level</label>
            <defaultValue>info</defaultValue>
        </input-field>
        <input-field type="text">
            <name>logpattern</name>
            <label>Log file pattern</label>
            <helpText>https://logging.apache.org/log4php/docs/layouts/pattern.html</helpText>
            <defaultValue>[%date{Y-m-d H:i:s.ssZ}] %method.%-0level: %message%n%ex</defaultValue>
        </input-field>
    </card>
    <card>
        <title>Log rotation settings</title>
        <input-field type="text">
            <name>maxbackupindex</name>
            <label>Max Numbers of Logfiles</label>
            <defaultValue>6</defaultValue>
        </input-field>
        <input-field type="text">
            <name>maxfilesize</name>
            <label>Max Logfile Size in MB</label>
            <defaultValue>6</defaultValue>
        </input-field>
        <input-field type="bool">
            <name>activeCompress</name>
            <label>Active compress rotated files</label>
        </input-field>
    </card>
    <card>
        <title>Log event email notification settings</title>
        <input-field type="bool">
            <name>activeNotificationMail</name>
            <label>General active notification emails</label>
        </input-field>
        <input-field type="single-select">
            <name>sendMailMode</name>
            <options>
                <option>
                    <id>eachEventOneMail</id>
                    <name>For each event one mail</name>
                </option>
                <option>
                    <id>eachLogLevelOneMail</id>
                    <name>For each Log Level only one mail</name>
                </option>
            </options>
            <defaultValue>eachLogLevelOneMail</defaultValue>
            <label>Send email mode</label>
        </input-field>
        <component name="sw-entity-single-select">
            <name>salesChannelId</name>
            <entity>sales_channel</entity>
            <label>SalesChannelId context</label>
        </component>
        <input-field type="text">
            <name>notificationMailAddress</name>
            <label>Notification mail address</label>
        </input-field>
        <component name="sw-entity-single-select">
            <name>notificationMailTemplateId</name>
            <entity>mail_template_type</entity>
            <label>Notification mail template</label>
        </component>
        <input-field type="bool">
            <name>notificationMailActiveDebug</name>
            <label>Active notification mail for Debug event</label>
        </input-field>
        <input-field type="bool">
            <name>notificationMailActiveInfo</name>
            <label>Active notification mail for Info event</label>
        </input-field>
        <input-field type="bool">
            <name>notificationMailActiveWarning</name>
            <label>Active notification mail for Warning event</label>
        </input-field>
        <input-field type="bool">
            <name>notificationMailActiveError</name>
            <label>Active notification mail for Error event</label>
        </input-field>
        <input-field type="bool">
            <name>notificationMailActiveCritical</name>
            <label>Active notification mail for Critical event</label>
        </input-field>
    </card>
    <card>
        <title>Outbound HTTP logging settings</title>
        <input-field type="bool">
            <name>activeHttpLogging</name>
            <label>Active outbound HTTP request logging</label>
            <helpText>Logs all outgoing HTTP requests (Symfony http_client, Store-/FRW-API) including URL, method, parameters, and body in var/log/outbound-http.muwa.log. No automatic masking of sensitive data - enable only for targeted debugging.</helpText>
        </input-field>
    </card>
    <card>
        <title>Admin change log</title>
        <title lang="de-DE">Änderungslog</title>
        <input-field type="bool">
            <name>activeChangeLog</name>
            <label>Active</label>
            <label lang="de-DE">Aktiv</label>
            <helpText>Records changes made in the administration. Errors of the change log are only written to a log file if "Active" (above) is switched on.</helpText>
            <helpText lang="de-DE">Protokolliert Änderungen in der Administration. Fehler des Änderungslogs werden nur in eine Log-Datei geschrieben, wenn "Active" (oben) eingeschaltet ist.</helpText>
        </input-field>
        <component name="muwa-change-log-entity-select">
            <name>changeLogEntities</name>
            <label>Tracked entities</label>
            <label lang="de-DE">Überwachte Entitäten</label>
            <defaultValue>["product","category","order","customer","cms_page"]</defaultValue>
        </component>
        <input-field type="int">
            <name>changeLogRetentionDays</name>
            <label>Retention in days (0 = never delete)</label>
            <label lang="de-DE">Aufbewahrung in Tagen (0 = nie löschen)</label>
            <defaultValue>90</defaultValue>
            <min>0</min>
        </input-field>
    </card>
</config>